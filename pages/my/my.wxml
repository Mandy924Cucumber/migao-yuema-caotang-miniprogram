<view class="my-container">
  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatarUrl || '/assets/icons/5.png'}}" mode="aspectFill"></image>
      <view class="user-details">
        <text class="nickname">{{userInfo.nickName || '访客'}}</text>
        <text class="member-info">{{userInfo.memberLevel || '未开通会员'}}</text>
        <text class="member-expire" wx:if="{{userInfo.memberExpireAt}}">到期：{{userInfo.memberExpireAt}}</text>
      </view>
    </view>
    <button class="login-btn" wx:if="{{!isLoggedIn}}" bindtap="handleLogin">点击登录</button>
    <button class="logout-btn" wx:else bindtap="handleLogout">退出</button>
  </view>

  <!-- 积分 + 快捷入口 -->
  <view class="quick-bar">
    <view class="quick-item" bindtap="goToMemberCenter">
      <text class="quick-num">{{userInfo.points || 0}}</text>
      <text class="quick-label">积分</text>
    </view>
    <view class="quick-divider"></view>
    <view class="quick-item" bindtap="goToCart">
      <text class="quick-num">{{cartCount}}</text>
      <text class="quick-label">购物车</text>
    </view>
    <view class="quick-divider"></view>
    <view class="quick-item" bindtap="goToOrders">
      <text class="quick-num">{{orderCount}}</text>
      <text class="quick-label">订单</text>
    </view>
  </view>

  <!-- 我的报名 -->
  <view class="section">
    <view class="section-title">我的报名</view>
    <view class="enroll-list" wx:if="{{enrollList.length > 0}}">
      <view class="enroll-item" wx:for="{{enrollList}}" wx:key="id" bindtap="goToCourseDetail" data-enroll="{{item}}">
        <view class="enroll-header">
          <text class="enroll-title">{{item.title}}</text>
          <text class="enroll-status {{item.status}}">
            {{item.status === 'paid' ? '已报名' : item.status === 'verified' ? '已核销' : '已退款'}}
          </text>
        </view>
        <text class="enroll-time">{{item.timeText}}</text>
        <text class="enroll-deposit" wx:if="{{item.deposit}}">押金：¥{{item.deposit}}</text>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text class="empty-text">还没有报名，去看看课程</text>
      <button class="empty-btn" bindtap="goToCourses">去报名</button>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="section">
    <view class="menu-item" bindtap="goToCart">
      <text class="menu-text">购物车</text>
      <view class="menu-right">
        <text class="menu-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
    <view class="menu-item" bindtap="goToOrders">
      <text class="menu-text">我的订单</text>
      <view class="menu-right">
        <text class="menu-badge" wx:if="{{orderCount > 0}}">{{orderCount}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
    <view class="menu-item" bindtap="goToMemberCenter">
      <text class="menu-text">会员中心</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToInvite">
      <text class="menu-text">邀请奖励</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="contactService">
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>
