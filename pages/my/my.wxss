.my-container {
  min-height: 100vh;
  background-color: #F5F0E8;
  background-image: repeating-linear-gradient(
    90deg,
    transparent 0,
    transparent 3px,
    rgba(196, 181, 154, 0.06) 3px,
    rgba(196, 181, 154, 0.06) 4px
  );
  padding-bottom: 20px;
}

.user-card {
  background: #FFFBF5;
  padding: 24px 20px;
  margin-bottom: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid #C4B59A;
  position: relative;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  width: 60px;
  height: 60px;
  border-radius: 30px;
  background: #F5F0E8;
  margin-right: 16px;
  border: 2px solid #C4B59A;
}

.user-details {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.nickname {
  font-size: 18px;
  font-weight: 600;
  color: #2C1810;
  letter-spacing: 1rpx;
}

.member-info {
  font-size: 14px;
  color: #6B5344;
}

.member-expire {
  font-size: 12px;
  color: #8B7355;
}

.login-btn {
  background: #2C1810 !important;
  color: #F5F0E8 !important;
  border-radius: 4px;
  padding: 8px 20px;
  font-size: 14px;
  border: 1px solid #2C1810;
  line-height: 1.4;
}

.logout-btn {
  background: #FFFBF5 !important;
  color: #8B7355 !important;
  border-radius: 4px;
  padding: 8px 16px;
  font-size: 13px;
  border: 1px solid #C4B59A;
  line-height: 1.4;
}

/* 快捷入口栏 */
.quick-bar {
  display: flex;
  align-items: center;
  background: #FFFBF5;
  padding: 16px 20px;
  margin-bottom: 16px;
  border-bottom: 1px solid #E8E0D4;
}

.quick-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.quick-num {
  font-size: 20px;
  font-weight: 700;
  color: #2C1810;
}

.quick-label {
  font-size: 12px;
  color: #8B7355;
}

.quick-divider {
  width: 1px;
  height: 28px;
  background: #D4C4A8;
}

.section {
  background: #FFFBF5;
  margin-bottom: 16px;
  padding: 20px;
  border: 1px solid #C4B59A;
  border-radius: 4px;
  margin-left: 16px;
  margin-right: 16px;
  box-shadow: 0 2px 12px rgba(44, 24, 16, 0.06);
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #2C1810;
  margin-bottom: 16px;
  padding-left: 12px;
  border-left: 4px solid #8B3A3A;
}

.enroll-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.enroll-item {
  padding: 16px;
  background: #F5F0E8;
  border-radius: 4px;
  border: 1px solid #D4C4A8;
}

.enroll-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8px;
}

.enroll-title {
  font-size: 15px;
  font-weight: 600;
  color: #2C1810;
  flex: 1;
}

.enroll-status {
  font-size: 12px;
  padding: 4px 8px;
  border-radius: 2px;
  margin-left: 8px;
}

.enroll-status.paid {
  background: rgba(139, 58, 58, 0.1);
  color: #8B3A3A;
  border: 1px solid rgba(139, 58, 58, 0.25);
}

.enroll-status.verified {
  background: rgba(74, 107, 90, 0.12);
  color: #4A6B5A;
  border: 1px solid rgba(74, 107, 90, 0.3);
}

.enroll-status.refunded {
  background: #E8E0D4;
  color: #8B7355;
  border: 1px solid #D4C4A8;
}

.enroll-time {
  font-size: 13px;
  color: #6B5344;
  display: block;
  margin-bottom: 4px;
}

.enroll-deposit {
  font-size: 13px;
  color: #6B5344;
}

.empty-state {
  text-align: center;
  padding: 40px 20px;
}

.empty-text {
  font-size: 14px;
  color: #8B7355;
  display: block;
  margin-bottom: 16px;
}

.empty-btn {
  background: #2C1810 !important;
  color: #F5F0E8 !important;
  border-radius: 4px;
  padding: 10px 24px;
  font-size: 14px;
  border: 1px solid #2C1810;
  line-height: 1.4;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid #E8E0D4;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-text {
  font-size: 15px;
  color: #2C1810;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.menu-badge {
  font-size: 11px;
  color: #FFFBF5;
  background: #8B3A3A;
  min-width: 18px;
  height: 18px;
  line-height: 18px;
  text-align: center;
  border-radius: 9px;
  padding: 0 5px;
}

.menu-arrow {
  font-size: 16px;
  color: #8B7355;
}
