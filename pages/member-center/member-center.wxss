.member-container {
  min-height: 100vh;
  background-color: #F5F0E8;
  padding-bottom: 100px;
}

.member-card {
  margin: 16px;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
  background: linear-gradient(135deg, #2C1810 0%, #4A2A1A 50%, #6B3A2A 100%);
  box-shadow: 0 4px 16px rgba(44, 24, 16, 0.2);
}

.card-content {
  position: relative;
  padding: 24px 20px;
  color: #F5F0E8;
  z-index: 1;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.card-brand {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.card-level {
  font-size: 14px;
  background: rgba(245, 240, 232, 0.15);
  padding: 4px 12px;
  border-radius: 12px;
  border: 1px solid rgba(245, 240, 232, 0.3);
}

.card-points {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 12px;
}

.points-num {
  font-size: 36px;
  font-weight: 700;
  color: #F5F0E8;
}

.points-label {
  font-size: 14px;
  color: rgba(245, 240, 232, 0.7);
}

.card-expire {
  font-size: 12px;
  color: rgba(245, 240, 232, 0.5);
}

.section {
  background: #FFFBF5;
  margin: 0 16px 16px;
  padding: 20px;
  border: 1px solid #C4B59A;
  border-radius: 4px;
  box-shadow: 0 2px 12px rgba(44, 24, 16, 0.06);
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #2C1810;
  margin-bottom: 16px;
  padding-left: 12px;
  border-left: 4px solid #8B3A3A;
}

.levels-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.level-item {
  padding: 16px;
  background: #F5F0E8;
  border-radius: 4px;
  border: 1px solid #D4C4A8;
  opacity: 0.6;
}

.level-item.unlocked {
  opacity: 1;
  border-color: #8B3A3A;
  background: rgba(139, 58, 58, 0.04);
}

.level-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.level-icon {
  font-size: 20px;
}

.level-name {
  font-size: 15px;
  font-weight: 600;
  color: #2C1810;
}

.level-points {
  font-size: 12px;
  color: #8B7355;
  margin-left: auto;
}

.level-tag {
  font-size: 11px;
  color: #FFFBF5;
  background: #8B3A3A;
  padding: 2px 8px;
  border-radius: 2px;
}

.level-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.benefit-item {
  font-size: 12px;
  color: #6B5344;
  background: #FFFBF5;
  padding: 4px 10px;
  border-radius: 2px;
  border: 1px solid #E8E0D4;
}

.points-list {
  display: flex;
  flex-direction: column;
}

.points-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid #E8E0D4;
}

.points-item:last-child {
  border-bottom: none;
}

.points-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.points-desc {
  font-size: 14px;
  color: #2C1810;
}

.points-time {
  font-size: 12px;
  color: #8B7355;
}

.points-value {
  font-size: 16px;
  font-weight: 600;
}

.points-value.earn {
  color: #4A6B5A;
}

.points-value.spend {
  color: #8B3A3A;
}

.empty-hint {
  text-align: center;
  padding: 24px;
  color: #8B7355;
  font-size: 14px;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background: #FFFBF5;
  border-top: 2px solid #C4B59A;
}

.open-btn {
  background: #2C1810 !important;
  color: #F5F0E8 !important;
  border-radius: 4px;
  padding: 12px 0;
  font-size: 16px;
  border: none;
  width: 100%;
}
