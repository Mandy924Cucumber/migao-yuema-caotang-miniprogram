/* 首页 · 参考极简白底 + 强 Banner + 大标题叠加 + 留白层级 */
/* 设计要点：纯白底、Banner 占 35%~45%、主标题强、少线少框、统一左对齐 */

.home-page {
  min-height: 100vh;
  background: #FFFFFF;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  box-sizing: border-box;
}

/* ---------- A. 顶部（安全区内，极简） ---------- */
.home-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: calc(env(safe-area-inset-top) + 32rpx);
  padding-bottom: 32rpx;
  padding-left: 0;
  padding-right: 0;
}

.home-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.home-member-btn {
  font-size: 26rpx;
  font-weight: 500;
  color: #7A7A7A;
  background: #F5F5F5;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  line-height: 1.3;
}

/* ---------- B. Banner 主视觉（第一视觉中心，约 40% 屏高感） ---------- */
.home-banner-wrap {
  margin-bottom: 48rpx;
}

.home-banner {
  width: 100%;
  height: 0;
  padding-bottom: 44%;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05);
}

.home-banner-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.home-banner-inner {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
}

.home-banner-sub {
  font-size: 26rpx;
  font-weight: 400;
  color: #7A7A7A;
  line-height: 1.45;
}

/* ---------- C. 功能入口区（留白分隔，无框线） ---------- */
.home-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  padding-left: 0;
}

.home-section-desc {
  font-size: 24rpx;
  font-weight: 400;
  color: #7A7A7A;
  margin-bottom: 28rpx;
  padding-left: 0;
}

.home-cards {
  display: flex;
  flex-wrap: wrap;
  margin-left: -10rpx;
  margin-right: -10rpx;
}

.home-card {
  width: calc(50% - 20rpx);
  margin-left: 10rpx;
  margin-right: 10rpx;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #EFEFEF;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  position: relative;
  overflow: hidden;
}

.home-card--emphasize .home-card-title {
  color: #1A1A1A;
}

.home-card-accent {
  position: absolute;
  left: 0;
  top: 36rpx;
  bottom: 36rpx;
  width: 6rpx;
  background: #1A1A1A;
  border-radius: 0 3rpx 3rpx 0;
  opacity: 0.25;
}

.home-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.35;
  margin-bottom: 12rpx;
  padding-left: 0;
}

.home-card-desc {
  font-size: 24rpx;
  font-weight: 400;
  color: #7A7A7A;
  line-height: 1.45;
  padding-left: 0;
}

/* 加载态 */
.home-skeleton {
  display: flex;
  flex-wrap: wrap;
  margin-left: -10rpx;
  margin-right: -10rpx;
  padding-top: 0;
}

.home-skeleton-card {
  width: calc(50% - 20rpx);
  margin-left: 10rpx;
  margin-right: 10rpx;
  margin-bottom: 20rpx;
  height: 160rpx;
  background: #F5F5F5;
  border-radius: 24rpx;
}

/* 空状态 */
.home-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #7A7A7A;
}
