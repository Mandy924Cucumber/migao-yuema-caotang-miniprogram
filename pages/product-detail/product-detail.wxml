<view class="product-detail-container">
  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <block wx:elif="{{productDetail.id}}">
    <!-- 商品图 -->
    <view class="product-image">
      <image wx:if="{{productDetail.imageUrl}}" class="product-img" src="{{productDetail.imageUrl}}" mode="aspectFill" />
      <view wx:else class="image-placeholder">{{productDetail.brand}}</view>
      <text class="product-name">{{productDetail.title}}</text>
    </view>

    <!-- 价格信息 -->
    <view class="detail-content">
      <view class="price-card">
        <text class="product-price">¥{{productDetail.price}}</text>
        <text class="product-brand">{{productDetail.brand}}</text>
        <text class="product-stock">库存：{{productDetail.stock}}</text>
      </view>

      <!-- 简介 -->
      <view class="desc-card" wx:if="{{productDetail.desc}}">
        <text class="desc-title">商品简介</text>
        <text class="desc-text">{{productDetail.desc}}</text>
      </view>

      <!-- 规格 -->
      <view class="specs-card" wx:if="{{productDetail.specs && productDetail.specs.length > 0}}">
        <text class="specs-title">规格</text>
        <view class="specs-list">
          <text class="spec-item" wx:for="{{productDetail.specs}}" wx:key="index">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 底部按钮：只在有商品時顯示 -->
    <view class="bottom-bar">
      <button class="btn-cart" bindtap="addToCart">加入购物车</button>
      <button class="btn-buy" bindtap="buyNow">立即购买</button>
    </view>
  </block>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-text">商品不存在</text>
    <button class="empty-btn" bindtap="goBack">返回</button>
  </view>
</view>
