/* 商品详情 · 中式背景与装饰 */
.product-detail-container {
  min-height: 100vh;
  background-color: #F5F0E8;
  background-image: repeating-linear-gradient(
    90deg,
    transparent 0,
    transparent 3px,
    rgba(196, 181, 154, 0.06) 3px,
    rgba(196, 181, 154, 0.06) 4px
  );
  padding-bottom: calc(80px + env(safe-area-inset-bottom));
}

.loading {
  text-align: center;
  padding: 60px 20px;
  color: #8B7355;
}

.product-image {
  position: relative;
  width: 100%;
  height: 300px;
  background: linear-gradient(180deg, #E8E0D4 0%, #F5F0E8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 2px solid #C4B59A;
  overflow: hidden;
}

.product-image .product-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.image-placeholder {
  color: #8B7355;
  font-size: 14px;
}

.product-name {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(44, 24, 16, 0.75), transparent);
  padding: 20px;
  font-size: 18px;
  font-weight: 600;
  color: #F5F0E8;
}

.detail-content {
  padding: 20px;
}

.price-card {
  background: #FFFBF5;
  border-radius: 4px;
  border: 1px solid #C4B59A;
  box-shadow: 0 2px 12px rgba(44, 24, 16, 0.06);
  padding: 20px;
  margin-bottom: 16px;
  position: relative;
  padding-left: 24px;
}
.price-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16px;
  bottom: 16px;
  width: 3px;
  background: #8B3A3A;
  border-radius: 0 2px 2px 0;
}

.product-price {
  font-size: 24px;
  font-weight: 600;
  color: #8B3A3A;
  display: block;
  margin-bottom: 8px;
}

.product-brand {
  font-size: 14px;
  color: #6B5344;
  display: block;
  margin-bottom: 8px;
}

.product-stock {
  font-size: 13px;
  color: #8B7355;
}

.desc-card,
.specs-card {
  background: #FFFBF5;
  border-radius: 4px;
  border: 1px solid #C4B59A;
  box-shadow: 0 2px 12px rgba(44, 24, 16, 0.06);
  padding: 20px;
  margin-bottom: 16px;
}

.desc-title,
.specs-title {
  font-size: 16px;
  font-weight: 600;
  color: #2C1810;
  display: block;
  margin-bottom: 12px;
  padding-left: 12px;
  border-left: 4px solid #8B3A3A;
}

.desc-text {
  font-size: 14px;
  color: #6B5344;
  line-height: 1.8;
}

.specs-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.spec-item {
  font-size: 13px;
  color: #2C1810;
  background: #F5F0E8;
  padding: 6px 12px;
  border-radius: 2px;
  border: 1px solid #D4C4A8;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFBF5;
  padding: 12px 20px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  border-top: 2px solid #C4B59A;
  box-shadow: 0 -2px 12px rgba(44, 24, 16, 0.08);
  display: flex;
  gap: 12px;
}

.btn-cart {
  flex: 1;
  background: #FFFBF5;
  color: #2C1810;
  border-radius: 4px;
  padding: 14px;
  font-size: 15px;
  border: 1px solid #C4B59A;
}

.btn-buy {
  flex: 1;
  background: #2C1810;
  color: #F5F0E8;
  border-radius: 4px;
  padding: 14px;
  font-size: 15px;
  font-weight: 600;
  border: 1px solid #2C1810;
}

.empty-state {
  text-align: center;
  padding: 60px 20px;
}

.empty-text {
  font-size: 14px;
  color: #8B7355;
  display: block;
  margin-bottom: 24px;
}

.empty-btn {
  background: #2C1810;
  color: #F5F0E8;
  border-radius: 4px;
  padding: 10px 24px;
  font-size: 14px;
  border: 1px solid #2C1810;
}
