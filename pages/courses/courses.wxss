/* 课程列表 · 中式背景与装饰 */
.courses-container {
  min-height: 100vh;
  background-color: #F5F0E8;
  background-image: repeating-linear-gradient(
    90deg,
    transparent 0,
    transparent 3px,
    rgba(196, 181, 154, 0.06) 3px,
    rgba(196, 181, 154, 0.06) 4px
  );
  display: flex;
  flex-direction: column;
  /* 保证课程页不横向滚动 */
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.search-bar {
  background: #FFFBF5;
  padding: 12px 20px;
  border-bottom: 2px solid #C4B59A;
}

.search-input {
  background: #F5F0E8;
  border-radius: 4px;
  padding: 10px 16px;
  font-size: 14px;
  border: 1px solid #D4C4A8;
  color: #2C1810;
}

.filter-scroll {
  background: #FFFBF5;
  white-space: nowrap;
  border-bottom: 1px solid #E8E0D4;
}

.filter-chips {
  display: flex;
  padding: 12px 20px;
  gap: 12px;
}

.filter-chip {
  padding: 6px 16px;
  border-radius: 4px;
  background: #F5F0E8;
  color: #6B5344;
  font-size: 14px;
  white-space: nowrap;
  border: 1px solid #D4C4A8;
}

.filter-chip.active {
  background: #2C1810;
  color: #F5F0E8;
  border-color: #2C1810;
}

.course-list {
  flex: 1;
  padding: 16px 20px;
  box-sizing: border-box;
}

.course-card {
  background: #FFFBF5;
  border-radius: 4px;
  border: 1px solid #C4B59A;
  box-shadow: 0 2px 12px rgba(44, 24, 16, 0.06);
  padding: 20px;
  margin-bottom: 16px;
  position: relative;
  padding-left: 24px;
}
.course-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16px;
  bottom: 16px;
  width: 3px;
  background: #8B3A3A;
  border-radius: 0 2px 2px 0;
}

.course-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12px;
}

.course-title {
  font-size: 16px;
  font-weight: 600;
  color: #2C1810;
  flex: 1;
}

.course-type-tag {
  font-size: 11px;
  color: #8B3A3A;
  background: rgba(139, 58, 58, 0.1);
  padding: 2px 8px;
  border-radius: 2px;
  border: 1px solid rgba(139, 58, 58, 0.3);
  margin-left: 8px;
}

.course-info {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 12px;
}

.info-item {
  font-size: 13px;
  color: #6B5344;
}

.course-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12px;
  border-top: 1px solid #E8E0D4;
}

.capacity {
  font-size: 13px;
  color: #6B5344;
}

.price {
  font-size: 15px;
  font-weight: 600;
  color: #2C1810;
}

.load-more {
  text-align: center;
  padding: 20px;
  color: #8B7355;
  font-size: 13px;
}

.empty-state {
  text-align: center;
  padding: 60px 20px;
}

.empty-text {
  font-size: 14px;
  color: #8B7355;
  margin-bottom: 24px;
}

.empty-btn {
  background: #2C1810;
  color: #F5F0E8;
  border-radius: 4px;
  padding: 10px 24px;
  font-size: 14px;
  border: 1px solid #2C1810;
}
