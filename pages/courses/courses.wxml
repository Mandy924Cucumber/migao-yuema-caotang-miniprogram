<view class="courses-container">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索课程/讲师/时间" value="{{searchKeyword}}" bindinput="onSearchInput" />
  </view>

  <!-- 筛选条 -->
  <scroll-view class="filter-scroll" scroll-x>
    <view class="filter-chips">
      <view class="filter-chip {{selectedType === 'all' ? 'active' : ''}}" bindtap="selectType" data-type="all">全部</view>
      <view class="filter-chip {{selectedType === 'public' ? 'active' : ''}}" bindtap="selectType" data-type="public">公益课</view>
      <view class="filter-chip {{selectedType === 'regular' ? 'active' : ''}}" bindtap="selectType" data-type="regular">常规课</view>
      <view class="filter-chip {{selectedType === 'trial' ? 'active' : ''}}" bindtap="selectType" data-type="trial">体验课</view>
    </view>
  </scroll-view>

  <!-- 课程列表 -->
  <scroll-view class="course-list" scroll-y refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore">
    <view class="course-card" wx:for="{{courseList}}" wx:key="id" bindtap="goToDetail" data-course="{{item}}">
      <view class="course-header">
        <text class="course-title">{{item.title}}</text>
        <text class="course-type-tag">{{item.type === 'public' ? '公益' : item.type === 'regular' ? '常规' : '体验'}}</text>
      </view>
      <view class="course-info">
        <text class="info-item">讲师：{{item.teacher}}</text>
        <text class="info-item">{{item.date}} {{item.time}}</text>
        <text class="info-item">地点：{{item.location}}</text>
      </view>
      <view class="course-footer">
        <text class="capacity">名额：{{item.remaining}}/{{item.capacity}}</text>
        <text class="price">{{item.type === 'public' ? '押金' : '价格'}}：¥{{item.type === 'public' ? item.deposit : item.price}}</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <text class="load-more-text">加载中...</text>
    </view>
    <view class="load-more" wx:if="{{!hasMore && courseList.length > 0}}">
      <text class="load-more-text">没有更多了</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && courseList.length === 0}}">
      <view class="empty-text">暂无课程</view>
      <button class="empty-btn" bindtap="goToHome">返回首页</button>
    </view>
  </scroll-view>
</view>
