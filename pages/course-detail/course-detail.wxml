<view class="course-detail-container">
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  
  <view class="detail-content" wx:else>
    <!-- 封面 -->
    <view class="cover-section">
      <view class="cover-placeholder">课程封面</view>
      <view class="cover-overlay">
        <text class="course-title">{{courseDetail.title}}</text>
        <text class="course-type-badge">{{courseDetail.type === 'public' ? '公益' : courseDetail.type === 'regular' ? '常规' : '体验'}}</text>
      </view>
    </view>

    <!-- 信息卡片 -->
    <view class="info-card">
      <view class="info-row">
        <text class="info-label">时间</text>
        <text class="info-value">{{courseDetail.date}} {{courseDetail.time}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">地点</text>
        <text class="info-value">{{courseDetail.location}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">讲师</text>
        <text class="info-value">{{courseDetail.teacher}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">名额</text>
        <text class="info-value">{{courseDetail.remaining}}/{{courseDetail.capacity}}</text>
      </view>
    </view>

    <!-- 简介 -->
    <view class="intro-card" wx:if="{{courseDetail.intro}}">
      <text class="intro-title">课程简介</text>
      <text class="intro-text">{{courseDetail.intro}}</text>
    </view>

    <!-- 规则 -->
    <view class="rules-card" wx:if="{{courseDetail.rules && courseDetail.rules.length > 0}}">
      <text class="rules-title">报名规则</text>
      <view class="rules-list">
        <text class="rule-item" wx:for="{{courseDetail.rules}}" wx:key="index">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button class="enroll-btn" bindtap="goToEnroll">
      {{courseDetail.type === 'public' ? '报名并支付押金' : '报名'}}
      <text wx:if="{{courseDetail.type === 'public'}}">¥{{courseDetail.deposit}}</text>
      <text wx:else>¥{{courseDetail.price}}</text>
    </button>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && !courseDetail.id}}">
    <text class="empty-text">课程不存在</text>
    <button class="empty-btn" bindtap="goBack">返回</button>
  </view>
</view>
